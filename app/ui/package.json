{
  "name": "atlas-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron ../electron/main.js",
    "electron:build": "electron-builder"
  },
  "dependencies": {
    "react": "^18",
    "react-dom": "^18",
    "lucide-react": "^0.300",
    "graphology": "^0.25",
    "sigma": "^2.3",
    "@codemirror/view": "^6.22",
    "@codemirror/state": "^6.4",
    "@codemirror/lang-rust": "^6.0",
    "@codemirror/lang-python": "^6.1",
    "@codemirror/lang-javascript": "^6.2",
    "@codemirror/lang-json": "^6.0",
    "@codemirror/lang-markdown": "^6.2",
    "@codemirror/language": "^6.10",
    "@lezer/common": "^1.2"
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "electron": "^28",
    "electron-builder": "^24",
    "vite": "^5",
    "tailwindcss": "^3.4",
    "autoprefixer": "^10.4",
    "postcss": "^8.4"
  },
  "build": {
    "appId": "com.atlas.navigator",
    "productName": "Atlas",
    "directories": {
      "output": "release"
    },
    "files": [
      "../electron/**/*",
      "gen/dist/**/*"
    ],
    "extraMetadata": {
      "main": "../electron/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "../electron/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "../electron/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "../electron/icons/icon.png"
    }
  }
}
